// Prisma schema file for Garments Production Planning & Analytics

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Unit {
  id            String           @id @default(cuid())
  code          String           @unique // e.g. "U02", "U03", "U04", "B2"
  name          String           // e.g. "Unit 02", "Unit 03"
  totalLines    Int              @default(0)
  totalManpower Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  lines         ProductionLine[]
  orders        Order[]
  dailyRecords  ProductionDaily[]

  @@map("units")
}

model ProductionLine {
  id           String            @id @default(cuid())
  name         String            @unique // e.g. "U02-01", "B2U2-05"
  unitId       String
  unitCode     String
  manpower     Int               @default(25)
  workingHours Float             @default(10.0)
  status       String            @default("ACTIVE")
  summaryJson  String?           // JSON string of { PLAN: {...}, SAH: {...}, MACHINE: {...}, EFFI: {...} }
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  unit         Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  orders       Order[]
  dailyRecords ProductionDaily[]

  @@index([unitId])
  @@index([unitCode])
  @@map("production_lines")
}

model Buyer {
  id           String            @id @default(cuid())
  name         String            @unique // e.g. "MS", "HEMA", "GAP", "TESCO", "NEXT"
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  orders       Order[]
  dailyRecords ProductionDaily[]

  @@map("buyers")
}

model Order {
  id            String            @id @default(cuid())
  orderCode     String            // e.g. SQBIR.MS.01201.FY25-26::KC.FBRIEF...
  ocs           String?
  subOc         String?
  buyerId       String
  buyerName     String
  unitId        String
  unitCode      String
  lineId        String?
  lineName      String?
  styleRef      String?
  article       String?
  season        String?
  poNo          String?
  color         String?
  orderQty      Int               @default(0)
  planQty       Int               @default(0)
  smv           Float             @default(0.0)
  mainCategory  String?
  subCategory   String?
  productType   String?
  orderStatus   String            @default("Confirmed")
  ott           DateTime?
  revisedOtt    DateTime?
  pcd           DateTime?
  psd           DateTime?
  pfd           DateTime?
  exFactory     DateTime?
  revisedDelivery DateTime?
  orderCreatedDate DateTime?
  fobPrice      Float?            @default(0.0)
  salesValue    Float?            @default(0.0)
  leadMerchant  String?
  orderDept     String?
  workingDays   Int?              @default(0)
  dailyPlanJson String?           // JSON string of { [dateString]: planQty }
  importBatchId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  buyer         Buyer             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  unit          Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  line          ProductionLine?   @relation(fields: [lineId], references: [id], onDelete: SetNull)
  importBatch   ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  dailyRecords  ProductionDaily[]

  @@index([buyerId])
  @@index([unitId])
  @@index([lineId])
  @@index([styleRef])
  @@index([poNo])
  @@index([season])
  @@index([orderStatus])
  @@map("orders")
}

model ProductionDaily {
  id              String          @id @default(cuid())
  date            DateTime
  dateString      String          // YYYY-MM-DD
  month           String          // e.g. "2026-10"
  orderId         String?
  lineId          String
  unitId          String
  buyerId         String?
  targetQty       Int?            @default(0)
  actualQty       Int?            @default(0)
  gap             Int?            @default(0)
  smv             Float?          @default(0.0)
  targetSah       Float?          @default(0.0)
  actualSah       Float?          @default(0.0)
  clockHours      Float?          @default(0.0)
  efficiency      Float?          @default(0.0) // (actualSah / clockHours) * 100
  plannedEfficiency Float?        @default(0.0) // (targetSah / clockHours) * 100
  achievementRate Float?          @default(0.0) // (actualQty / targetQty) * 100
  manpower        Int             @default(25)
  importBatchId   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  order           Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  line            ProductionLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  unit            Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  buyer           Buyer?          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  importBatch     ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([dateString])
  @@index([month])
  @@index([unitId])
  @@index([lineId])
  @@index([buyerId])
  @@index([orderId])
  @@map("production_daily")
}

model ImportBatch {
  id           String            @id @default(cuid())
  fileName     String
  fileSize     Int               @default(0)
  month        String            @default("2026-10")
  totalRows    Int               @default(0)
  importedRows Int               @default(0)
  skippedRows  Int               @default(0)
  status       String            @default("SUCCESS")
  summary      String?           // JSON summary string
  createdAt    DateTime          @default(now())

  orders       Order[]
  dailyRecords ProductionDaily[]

  @@map("import_batches")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ==========================================
// EXCEL IMPORT & FILE PROCESSING WORKFLOW
// ==========================================

model FileUpload {
  id            String       @id @default(cuid())
  fileName      String
  originalName  String?
  fileSize      Int          @default(0)
  fileFormat    String       // xlsx, xlsb, xls, xlsm, csv
  fileHash      String?
  status        String       @default("PENDING") // PENDING, PROCESSING, READY_FOR_PREVIEW, IMPORTING, COMPLETED, FAILED, CANCELLED
  totalSheets   Int          @default(0)
  totalRows     Int          @default(0)
  importedRows  Int          @default(0)
  skippedRows   Int          @default(0)
  errorRows     Int          @default(0)
  uploadedBy    String?      @default("System User")
  importMode    String       @default("INSERT_UPDATE") // INSERT, UPDATE, INSERT_UPDATE, PREVIEW_ONLY
  meta          String?      // JSON string for sheet metadata, stats, summary
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sheets        FileSheet[]
  rows          ImportRow[]
  errors        ImportError[]
  monitoringRecords ProductionMonitoringRecord[]
  clockHourRecords  LineClockHourRecord[]
  lossAnalysisRecords LossAnalysisRecord[]

  @@index([fileHash])
  @@index([status])
  @@index([createdAt])
  @@map("file_uploads")
}

model FileSheet {
  id             String      @id @default(cuid())
  fileUploadId   String
  sheetName      String
  sheetIndex     Int         @default(0)
  rowCount       Int         @default(0)
  colCount       Int         @default(0)
  headerRowIndex Int         @default(0)
  headersJson    String?     // JSON array of detected header strings
  sampleDataJson String?     // JSON array of first 5-10 rows
  status         String      @default("DETECTED")
  createdAt      DateTime    @default(now())

  fileUpload     FileUpload  @relation(fields: [fileUploadId], references: [id], onDelete: Cascade)

  @@index([fileUploadId])
  @@index([sheetName])
  @@map("file_sheets")
}

model ImportTemplate {
  id               String    @id @default(cuid())
  name             String    @unique // e.g. "Actual Daily Production", "Sign-Off Capacity Plan", "Loss Time Tracker"
  description      String?
  sheetNamePattern String?   // regex or keyword match e.g. "Actual", "Report", "Loss Time"
  targetModel      String    // "ProductionMonitoringRecord", "LineClockHourRecord", "Order"
  mappingsJson     String    // JSON array of { sourceCol: string|number, targetField: string, required: boolean, transform: string }
  isDefault        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("import_templates")
}

model ImportRow {
  id                   String     @id @default(cuid())
  fileUploadId         String
  sheetName            String
  sourceRowIndex       Int
  rawRowJson           String     // JSON array of raw cell strings/numbers
  parsedRowJson        String?    // JSON object of mapped fields
  validationStatus     String     @default("PENDING") // VALID, WARNING, ERROR, PENDING, IMPORTED, SKIPPED
  validationErrorsJson String?    // JSON array of error messages/warnings
  isEdited             Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  fileUpload           FileUpload @relation(fields: [fileUploadId], references: [id], onDelete: Cascade)

  @@index([fileUploadId])
  @@index([sheetName])
  @@index([validationStatus])
  @@map("import_rows")
}

model ImportError {
  id           String     @id @default(cuid())
  fileUploadId String
  sheetName    String?
  rowIndex     Int?
  colIndex     Int?
  fieldName    String?
  errorType    String     // REQUIRED_FIELD, TYPE_MISMATCH, UNKNOWN_LINE, UNKNOWN_BUYER, DUPLICATE, CALC_MISMATCH
  errorMessage String
  rawValue     String?
  isResolved   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  fileUpload   FileUpload @relation(fields: [fileUploadId], references: [id], onDelete: Cascade)

  @@index([fileUploadId])
  @@index([errorType])
  @@map("import_errors")
}

// ==========================================
// PRODUCTION MONITORING & ANALYTICS RECORDS
// ==========================================

model ProductionMonitoringRecord {
  id                 String      @id @default(cuid())
  code               String?     // e.g. "46266B1U2-01" or unique identifier
  date               DateTime
  dateString         String      // YYYY-MM-DD
  month              String      // e.g. "2026-09"
  unitLine           String      // e.g. "B1U2-01"
  unitCode           String      // e.g. "B1U2", "B1U3", "B2U2", "S1U1"
  cluster            String?     // e.g. "B1", "B2", "Styrax"
  buyer              String?
  style              String?
  oc                 String?
  categoryType       String?     // e.g. "P1-BASIC PANTY", "Bra", "Activewear"
  productType        String?     // Panty, Bra, Short, etc.
  fobPrice           Float?      @default(0.0)
  vaPrice            Float?      @default(0.0)
  smv                Float?      @default(0.0)
  targetQty          Int?        @default(0) // Plan Pcs
  actualQty          Int?        @default(0) // Actual Pcs
  varianceQty        Int?        @default(0) // Actual - Plan
  mo                 Float?      @default(0.0) // Manpower equivalent
  clockHours         Float?      @default(0.0)
  targetSah          Float?      @default(0.0) // Plan SAH
  actualSah          Float?      @default(0.0) // Actual SAH
  varianceSah        Float?      @default(0.0)
  efficiency         Float?      @default(0.0) // Actual Efficiency %
  plannedEfficiency  Float?      @default(0.0)
  achievementRate    Float?      @default(0.0) // (actualQty / targetQty) * 100
  fobValue           Float?      @default(0.0) // Total FOB
  vaValue            Float?      @default(0.0) // Total VA
  remarks            String?
  fileUploadId       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  fileUpload         FileUpload? @relation(fields: [fileUploadId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([dateString])
  @@index([month])
  @@index([unitLine])
  @@index([unitCode])
  @@index([cluster])
  @@index([buyer])
  @@index([style])
  @@index([oc])
  @@index([fileUploadId])
  @@map("production_monitoring_records")
}

model LineClockHourRecord {
  id           String      @id @default(cuid())
  date         DateTime
  dateString   String      // YYYY-MM-DD
  month        String      // e.g. "2026-09"
  line         String      // e.g. "B1U2-01"
  unit         String      // e.g. "B1U2"
  cluster      String      // e.g. "B1", "B2", "Styrax"
  payrollMo    Int         @default(0)
  absentLeave  Int         @default(0)
  mlv          Int         @default(0)
  present      Int         @default(0)
  lineTransfer Int         @default(0)
  moForClkHrs  Int         @default(0)
  clockHour    Float       @default(0.0)
  absentRate   Float?      @default(0.0)
  fileUploadId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  fileUpload   FileUpload? @relation(fields: [fileUploadId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([dateString])
  @@index([month])
  @@index([line])
  @@index([unit])
  @@index([cluster])
  @@index([fileUploadId])
  @@map("line_clock_hour_records")
}

model LossAnalysisRecord {
  id              String      @id @default(cuid())
  date            DateTime
  dateString      String      // YYYY-MM-DD
  month           String      // e.g. "2026-09"
  cluster         String      // "B1", "B2", "Styrax"
  unit            String?     // "B1U2", "B1U3", "B1U4", "B2U2", etc.
  department      String      // "Production", "Marketing", "SCM", "HR", "Cutting", "Sewing Technical", etc.
  deptCode        String?     // "Prod", "Mkt", "SCM", "HR", "CU", "S.TC", etc.
  lostSah         Float       @default(0.0)
  lostHours       Float?      @default(0.0)
  sharePercentage Float?      @default(0.0)
  reason          String?
  fileUploadId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  fileUpload      FileUpload? @relation(fields: [fileUploadId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([dateString])
  @@index([month])
  @@index([cluster])
  @@index([unit])
  @@index([department])
  @@index([fileUploadId])
  @@map("loss_analysis_records")
}

model AuditLog {
  id           String    @id @default(cuid())
  action       String    // CREATE, UPDATE, DELETE, IMPORT, REVALIDATE, OVERRIDE
  entityType   String    // ProductionMonitoringRecord, Order, FileUpload, etc.
  entityId     String?
  oldValueJson String?
  newValueJson String?
  userId       String?
  userEmail    String?
  ipAddress    String?
  details      String?
  createdAt    DateTime  @default(now())

  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
